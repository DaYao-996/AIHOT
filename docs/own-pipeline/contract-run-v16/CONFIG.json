{
  "version": "contract-run-v16",
  "frozen": true,
  "network": "official listing and detail pages, detail budget 2",
  "doNotEnableRoles": ["excluded", "observe", "manual_gap", "optional", "checklist"],
  "budget": { "detailMaxFetches": 2, "initialBackfillLimit": 2 },
  "connect": [
    {
      "sourceId": "thinking_machines_news",
      "role": "operational",
      "intervalMinutes": 1440,
      "kind": "web_list",
      "config": {
        "url": "https://thinkingmachines.ai/news/",
        "parseMode": "html",
        "itemSelector": "ol.post-group > li",
        "linkSelector": "a.post-item-link",
        "titleSelector": "h2.post-title",
        "publishedAtSelector": "time",
        "publishedAtUtcOffset": "+00:00",
        "allowUrlPrefixes": ["https://thinkingmachines.ai/news/"],
        "detail": { "maxFetches": 2 },
        "_aihot": { "initialBackfillLimit": 2 }
      }
    },
    {
      "sourceId": "meta_research_blog",
      "role": "operational",
      "intervalMinutes": 1440,
      "kind": "web_list",
      "config": {
        "url": "https://research.meta.ai/blog/",
        "parseMode": "html",
        "itemSelector": "article[data-blog-post-summary='card']",
        "linkSelector": "a[href*='/blog/']",
        "titleSelector": "h2",
        "publishedAtSelector": "time",
        "publishedAtUtcOffset": "+00:00",
        "allowUrlPrefixes": ["https://research.meta.ai/blog/"],
        "detail": { "maxFetches": 2 },
        "_aihot": { "initialBackfillLimit": 2 }
      }
    },
    {
      "sourceId": "nvidia_newsroom_page",
      "role": "operational",
      "intervalMinutes": 1440,
      "kind": "web_list",
      "listingScope": "featured carousel only; the rest of the newsroom is not a stable card",
      "config": {
        "url": "https://nvidianews.nvidia.com/",
        "parseMode": "html",
        "itemSelector": "article.carousel-item-wrapper",
        "linkSelector": "h2 a",
        "titleSelector": "h2 a",
        "allowUrlPrefixes": ["https://nvidianews.nvidia.com/news/"],
        "detail": { "maxFetches": 2 },
        "_aihot": { "initialBackfillLimit": 2 }
      }
    },
    {
      "sourceId": "anthropic_news_page",
      "role": "operational",
      "intervalMinutes": 1440,
      "kind": "web_list",
      "listingDates": "headline anchor does not contain the card time",
      "config": {
        "url": "https://www.anthropic.com/news",
        "parseMode": "html",
        "itemSelector": "a:has([data-component='Headline'])",
        "titleSelector": "[data-component='Headline']",
        "allowUrlPrefixes": ["https://www.anthropic.com/"],
        "detail": { "maxFetches": 2 },
        "_aihot": { "initialBackfillLimit": 2 }
      }
    }
  ]
}
