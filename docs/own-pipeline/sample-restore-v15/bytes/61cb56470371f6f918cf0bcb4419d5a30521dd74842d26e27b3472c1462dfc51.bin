929364850\":{\"defaultValue\":true},\"2978416539\":{\"defaultValue\":true},\"3179909265\":{\"defaultValue\":{}},\"3267340979\":{\"defaultValue\":true},\"3432476598\":{\"defaultValue\":true},\"3467903727\":{\"defaultValue\":false},\"3485088533\":{\"defaultValue\":true},\"3689752867\":{\"defaultValue\":false},\"3692009606\":{\"defaultValue\":true},\"3814222110\":{\"defaultValue\":false},\"3938891541\":{\"defaultValue\":false},\"4117437795\":{\"defaultValue\":true},\"4214472288\":{\"defaultValue\":null},\"4217151214\":{\"defaultValue\":true}},\"hashing_algorithm\":\"djb2\",\"user\":{\"anonymousId\":\"b1bd95af-36de-4a51-8220-8643f4733d56\",\"stableId\":\"b1bd95af-36de-4a51-8220-8643f4733d56\"}},\"intercom_account_hash\":null,\"intercom_user_jwt\":null,\"locale\":null,\"system_prompts\":null,\"feature_flags\":{\"user\":{},\"values\":{},\"values_hash\":\"\"},\"served_copy\":{\"auth.code_connect.banner_b\":\"您拥有 Ultra 套餐！\",\"auth.code_connect.individual.required\":\"连接 Claude Code 需要 Claude Max、Ultra 或 Pro 套餐\",\"auth.code_connect.individual.signup\":\"请注册 Max、Ultra 或 Pro 套餐以连接您的账户，或使用您的 API 密钥。\",\"auth.code_connect.individual.upgrade\":\"升级至 Max、Ultra 或 Pro\",\"auth.code_connect.team.required\":\"连接 Claude Code 需要 Claude Max、Ultra、Pro 或 Team 套餐\",\"auth.code_connect.team.signup\":\"请注册 Max、Ultra、Pro 或 Team 套餐以连接您的账户，或使用您的 API 密钥。\",\"auth.code_connect.team.upgrade\":\"升级至 Max、Ultra、Pro 或 Team\",\"auth.office_addin.plans\":\"{suiteName} 中的 Claude 适用于 Pro、Max、Ultra、Team 和 Enterprise 套餐\",\"auth.office_addin.plans_only\":\"Claude 在 {suiteName} 中仅适用于 Pro、Max、Ultra、Team 和 Enterprise 套餐\",\"console.login.chat_plan_banner\":\"拥有 Pro、Max 或 Ultra 套餐？使用您的对话账户登录\",\"console.oauth.continue_b\":\"使用 Claude Ultra 继续\",\"console.oauth.includes_code_b\":\"您的 Claude Ultra 套餐包含 Claude Code\",\"web.admin.members_max_row_label\":\"Claude Max 和 Ultra\",\"web.billing.address_changed\":\"您的账单地址自上次账单以来已更改。如需升级至 {tier, select, max_20x {Ultra} other {Max}}，请联系客服寻求帮助。\",\"web.billing.cancel.keep_named\":\"保留 {tier, select, max_20x {Ultra} other {Max}}\",\"web.billing.cancel.offer_desc\":\"Max 拥有相同的模型和功能，且每 5 小时及每周用量均为 Pro 的 5 倍。\",\"web.billing.cancel.offer_title\":\"切换到 Max\",\"web.billing.cancel.offer_title_priced\":\"切换至 Max · {price}/月\",\"web.billing.cancel.switch_cta\":\"切换至 Max\",\"web.billing.cancel.switch_instead\":\"改为切换至 Max\",\"web.billing.coupon_applied\":\"优惠券已应用。Ultra 享 {percentOff}% 折扣，有效期 {durationInMonths, plural, one {# 个月} other {# 个月}}。\",\"web.billing.invoice_line_period\":\"{name} 套餐 · {start} – {end}\",\"web.billing.keep_access\":\"您将继续使用 Claude {name}。\",\"web.billing.keep_access_dated\":\"您将继续使用 Claude {name}，下次扣款将于 {resumeDate} 处理。\",\"web.billing.past_due_card\":\"您 {date} 到期的 {amount} {name} 套餐付款无法从 {card} 扣款。账单付清前，访问权限已暂停。\",\"web.billing.past_due_nocard\":\"您 {date} 到期的 {amount} {name} 套餐付款未能成功处理。账单付清前，访问权限已暂停。\",\"web.billing.past_due_resubscribe\":\"您的订阅已暂停，此账单无法在此处支付。如需恢复 {name}，请在设置 \u003e 账单中取消此套餐，然后使用有效的银行卡重新订阅，或联系支持。\",\"web.billing.phone_verify_continue\":\"请验证手机号码以继续使用 {tier, select, max_20x {Ultra} other {Max}}。\",\"web.billing.plan_active_toast\":\"您的 {name} 套餐已激活\",\"web.billing.promo_renewal_note\":\"您的订阅包含限时促销折扣。您的订阅将以 {discountedPrice} / {billingInterval, select, yearly {年} monthly {月} other {月}} 的折扣价自动续费（另加适用税费），直至 {promoEndDate}，届时您将自动降级回当前订阅套餐，除非您选择保留 {tier, select, max_20x {Ultra} other {Max}}。\",\"web.billing.prorated_credit\":\"{name} 套餐剩余时长的按比例折算抵扣金额\",\"web.billing.region_body\":\"您所在地区目前无法使用 Max 和 Ultra 套餐。请查看\u003clink\u003e支持地区列表\u003c/link\u003e了解更多信息。\",\"web.billing.region_title\":\"Max 和 Ultra 套餐不可用\",\"web.billing.renew_current\":\"续订当前 {name} 套餐\",\"web.billing.trial_end_note\":\"{tier, select, max_20x {您的 Pro 试用将立即结束。升级至 Ultra 将开始您的付费订阅，您将从今天起每周获得用量为 Pro 的 10 倍。} other {您的 Pro 试用将立即结束。升级至 Max 将开始您的付费订阅，您将从今天起每 5 小时及每周获得用量为 Pro 的 5 倍。}}\",\"web.billing.unpayable_resubscribe\":\"此账单无法在此处支付——未产生任何费用。如需恢复 {name}，请在设置 \u003e 账单中取消此套餐，然后使用有效的银行卡重新订阅，或联系支持。\",\"web.billing.upgrade_tier_cta\":\"升级至 Ultra\",\"web.billing.upgraded_toast\":\"已升级至 {tier, select, max_20x {Ultra} other {Max}} 套餐\",\"web.billing.welcome_heading\":\"欢迎使用 {name}\",\"web.billing.welcome_splash_title\":\"开始使用您的新 {name} 套餐\",\"web.chat.past_due_title\":\"您的 {name} 套餐付款未能成功处理\",\"web.checkout.line_item_monthly\":\"{tier, select, max_20x {Ultra} other {Max}} 按月计费\",\"web.checkout.tier_toggle_label\":\"选择 Max 或 Ultra\",\"web.chrome.plans_faq\":\"Chrome 中的 Claude 适用于所有付费 Claude 套餐（Pro、Max、Ultra、Team 和 Enterprise）。请从 Chrome 网上应用店安装扩展程序，使用您的 Claude 账户登录，即可开始使用。建议您在开始前查阅我们的安全指南。\",\"web.code.settings_upgrade_cta\":\"升级至 Pro、Max 或 Ultra\",\"web.code_install.welcome\":\"欢迎使用 {tier, select, max_20x {Claude Ultra} other {Claude Max}}！\",\"web.desktop.code_upgrade_hint\":\"升级至 Pro、Max 或 Ultra 以在桌面端使用 Claude Code。\",\"web.desktop.computer_use_plans\":\"计算机使用功能适用于 Pro、Max 和 Ultra 套餐。\",\"web.directory.blocked_personal\":\"如需以个人身份提交，请从账户菜单切换至个人 Pro、Max 或 Ultra 账户。\",\"web.directory.blocked_plans\":\"Pro、Max、Ultra、Team 和 Enterprise 套餐可向 Claude Directory 提交插件和 MCP 服务器，供其他组织安装。\",\"web.downgrade.heading\":\"切换至 Max 套餐\",\"web.downgrade.keep_plan_link\":\"保留您的 {name} 套餐\",\"web.downgrade.loss_note\":\"切换至 Max 后，您的用量将减少，可能更快达到使用限额。\",\"web.downgrade.scheduled_toast\":\"您的订阅已安排在当前计费周期结束时降级至 Max 套餐。\",\"web.downgrade.target_summary\":\"Max（每 5 小时及每周用量均为 Pro 的 5 倍）\",\"web.gift.faq_membership\":\"Claude 礼品会员资格可让他人在特定时间内使用 Claude Pro、Claude Max 或 Claude Ultra。他们将享有付费订阅的所有权益，包括使用我们最新模型、Claude Code 以及无限项目的权限。\",\"web.gift.redeem_higher_tier\":\"您当前使用的是 {name}，级别高于您获赠的 {tier} 套餐。我们已改为向您的账户添加 {credit} 额度。\",\"web.limits.title_opus\":\"使用 Pro、Max 和 Ultra 套餐获取更多 Opus\",\"web.login.plan_card.subtitle\":\"Max：每 5 小时及每周用量均为 Pro 的 5 倍。Ultra：每周用量为 Pro 的 10 倍\",\"web.login.plan_card.title\":\"Max 和 Ultra\",\"web.login.plans_faq\":\"Claude 提供六种定价套餐——Free、Pro、Max、Ultra、Team 和 Enterprise。Free 套餐提供有限使用，无需付款。\u003ca\u003e了解更多可用定价套餐信息\u003c/a\u003e。\",\"web.plan.product_name\":\"Claude {name}\",\"web.plan_label.max_20x\":\"Ultra 套餐\",\"web.plan_name.max_20x\":\"Ultra\",\"web.plan_name.max_5x\":\"Max\",\"web.plans.cowork_max_sub\":\"充分发挥 Cowork 的潜力。Max：每 5 小时及每周用量均为 Pro 的 5 倍。Ultra：每周用量为 Pro 的 10 倍\",\"web.plans.help_choose_max\":\"充分发挥 Claude 的潜力：使用 Max 可享每 5 小时及每周用量均为 Pro 的 5 倍，或使用 Ultra* 可享每周用量为 Pro 的 10 倍，并在高峰时段享有优先访问权。\",\"web.plans.max_card_cta\":\"{shown, select, 20x {获取 Ultra 套餐} other {获取 Max 或 Ultra 套餐}}\",\"web.plans.max_card_heading\":\"Max 和 Ultra\",\"web.teachers.verification_permanent\":\"验证是永久性的。一旦获批，此账户将成为免费的 Claude for Teachers 账户，其上的任何付费套餐将终止：您现有的对话将保留在该账户中并受学生数据隐私保护，且无法切换回个人 Free、Pro、Max 或 Ultra 套餐。如果您日后需要个人套餐，则需要单独注册一个 Claude 账户。\",\"web.team.checkout_declined_note\":\"您现有的项目和对话不会迁移，且您现有的 {name} 套餐订阅将在取消前自动续费。\u003clink\u003e了解更多\u003c/link\u003e\",\"web.team.checkout_existing_plan_note\":\"订阅 Team 套餐将创建新账户。您现有的项目和对话不会迁移，且您现有的 {name} 套餐订阅将在取消前自动续费。\u003clink\u003e了解更多\u003c/link\u003e\",\"web.upgrade.already_subscribed\":\"您已在使用 {name}\",\"web.upgrade.code_connect_heading\":\"Claude Code 包含在 Pro、Max 和 Ultra 中\",\"web.upgrade.from_existing_title\":\"使用 Max 或 Ultra 提升您的用量\",\"web.upgrade.subline_chrome\":\"仅限 Max 和 Ultra 套餐订阅者使用\",\"web.upgrade.subline_design\":\"Claude Design 已包含在 Pro、Max 和 Ultra 套餐中。\",\"web.upgrade.subline_model\":\"您所需的模型已包含在 Pro、Max 和 Ultra 套餐中。\",\"web.upgrade.subline_opus\":\"Claude Opus 已包含在 Pro、Max 和 Ultra 套餐中。\",\"web.usage.credits_destination\":\"额度将计入\u003cb\u003e您的 {name} 套餐\u003c/b\u003e · {email}\",\"web.usage.purchase_destination\":\"{email}（{name}）\",\"web.usage.unavailable_toast\":\"用量设置仅适用于 Pro、Max 和 Ultra 套餐。请升级以查看您的用量。\"}},\"dataUpdateCount\":1,\"dataUpdatedAt\":1794985396522,\"error\":null,\"errorUpdateCount\":0,\"errorUpdatedAt\":0,\"fetchFailureCount\":0,\"fetchFailureReason\":null,\"fetchMeta\":null,\"isInvalidated\":false,\"status\":\"success\",\"fetchStatus\":\"idle\"},\"queryKey\":[\"current_account\",null],\"queryHash\":\"[\\\"current_account\\\",null]\"}]},\"gates\":{\"console_horchata\":true,\"console_hummus\":true},\"chunkMap\"