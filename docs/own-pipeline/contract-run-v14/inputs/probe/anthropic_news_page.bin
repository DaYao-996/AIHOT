99fd7d65c8f5e2f50bf9336e4.png?w=1200&amp;q=75&amp;fm=webp&amp;fit=max 1200w, https://assets.claude.com/701946d96f607f199fd7d65c8f5e2f50bf9336e4.png?w=1920&amp;q=75&amp;fm=webp&amp;fit=max 1920w, https://assets.claude.com/701946d96f607f199fd7d65c8f5e2f50bf9336e4.png?w=2048&amp;q=75&amp;fm=webp&amp;fit=max 2048w, https://assets.claude.com/701946d96f607f199fd7d65c8f5e2f50bf9336e4.png?w=3840&amp;q=75&amp;fm=webp&amp;fit=max 3840w" src="https://assets.claude.com/701946d96f607f199fd7d65c8f5e2f50bf9336e4.png?w=3840&amp;q=75&amp;fm=webp&amp;fit=max"/></a></li><li class="_5NNTzG_embla-slide"><a class="_5NNTzG_slide-link" tabindex="-1" aria-hidden="true" href="/features/claude-on-mars"><img alt="The first AI-planned drive on Mars" loading="eager" width="1407" height="793" decoding="async" data-nimg="1" style="color:transparent" sizes="100vw" srcSet="https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=640&amp;q=75&amp;fm=webp&amp;fit=max 640w, https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=750&amp;q=75&amp;fm=webp&amp;fit=max 750w, https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=828&amp;q=75&amp;fm=webp&amp;fit=max 828w, https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=1080&amp;q=75&amp;fm=webp&amp;fit=max 1080w, https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=1200&amp;q=75&amp;fm=webp&amp;fit=max 1200w, https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=1920&amp;q=75&amp;fm=webp&amp;fit=max 1920w, https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=2048&amp;q=75&amp;fm=webp&amp;fit=max 2048w, https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=3840&amp;q=75&amp;fm=webp&amp;fit=max 3840w" src="https://assets.claude.com/abd2e56dedd42b609ec27783edba421fa2bfee4e.png?w=3840&amp;q=75&amp;fm=webp&amp;fit=max"/></a></li></ul></div></div><div class="_5NNTzG_carousel-info"><div class="_5NNTzG_carousel-info-slides"><div class="_5NNTzG_carousel-info-body"><header class="nUeDbq_header _5NNTzG_carousel-info-meta"><div class="nUeDbq_headerButton"><button aria-label="Related to The Situation Report" class="hN4zBq_tiny-more-button hN4zBq_state-closed" type="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_3q9dab5fiv9kcnnb_" aria-haspopup="dialog" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></div><p><a class="wN10Da_link" href="/news/features">Features</a></p><time class="_5NNTzG_carousel-info-date">Sep 21, 2026</time></header><a class="_5NNTzG_carousel-info-link" href="/features/ebola-response"><h2 class="tOQyXa_headline-5 _5NNTzG_carousel-info-title" data-component="Headline">The Situation Report</h2></a><p class="tOQyXa_body-4 _5NNTzG_carousel-info-description" data-component="Body">A rare Ebola strain is spreading in the DRC, with no confirmed vaccine. Global health organizations are using Claude to respond as fast as possible.</p><a href="/features/ebola-response" class="f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-secondary f9ZZrG_size-small f9ZZrG_icon-format-trailing _5NNTzG_carousel-info-cta">Read more<span class="f9ZZrG_icon"><svg class="lqbdHG_icon" width="20" height="20" viewBox="0 0 21 21"><path d="M4.14585 9.87492L14.4584 9.87492L9.60419 5.04158L10.5 4.14575L16.8542 10.4999L10.5 16.8541L9.60419 15.9583L14.4584 11.1249L4.14585 11.1249L4.14585 9.87492Z" fill="currentColor"></path></svg></span></a></div><div class="_5NNTzG_carousel-info-body" data-inactive="true" aria-hidden="true" inert=""><header class="nUeDbq_header _5NNTzG_carousel-info-meta"><div class="nUeDbq_headerButton"><button aria-label="Related to Scenarios for our economic future" class="hN4zBq_tiny-more-button hN4zBq_state-closed" type="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_3qadab5fiv9kcnnb_" aria-haspopup="dialog" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></div><p><a class="wN10Da_link" href="/research/team/economics">Economics</a></p><time class="_5NNTzG_carousel-info-date">Sep 9, 2026</time></header><a class="_5NNTzG_carousel-info-link" href="/institute/econ-scenarios"><h2 class="tOQyXa_headline-5 _5NNTzG_carousel-info-title" data-component="Headline">Scenarios for our economic future</h2></a><p class="tOQyXa_body-4 _5NNTzG_carousel-info-description" data-component="Body">Anthropic’s Economics team is sharing a new model of how AI may affect economic growth, jobs, wages, and more by 2030. The model lets you explore the scenarios, tell us what you think will happen, and see how your answers compare to +10,000 Americans.</p><a href="/institute/econ-scenarios" class="f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-secondary f9ZZrG_size-small f9ZZrG_icon-format-trailing _5NNTzG_carousel-info-cta">Read more<span class="f9ZZrG_icon"><svg class="lqbdHG_icon" width="20" height="20" viewBox="0 0 21 21"><path d="M4.14585 9.87492L14.4584 9.87492L9.60419 5.04158L10.5 4.14575L16.8542 10.4999L10.5 16.8541L9.60419 15.9583L14.4584 11.1249L4.14585 11.1249L4.14585 9.87492Z" fill="currentColor"></path></svg></span></a></div><div class="_5NNTzG_carousel-info-body" data-inactive="true" aria-hidden="true" inert=""><header class="nUeDbq_header _5NNTzG_carousel-info-meta"><div class="nUeDbq_headerButton"><button aria-label="Related to The making of Claude Code" class="hN4zBq_tiny-more-button hN4zBq_state-closed" type="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_3qbdab5fiv9kcnnb_" aria-haspopup="dialog" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></div><p><a class="wN10Da_link" href="/news/features">Features</a></p><time class="_5NNTzG_carousel-info-date">Feb 23, 2026</time></header><a class="_5NNTzG_carousel-info-link" href="/features/making-of-claude-code"><h2 class="tOQyXa_headline-5 _5NNTzG_carousel-info-title" data-component="Headline">The making of Claude Code</h2></a><p class="tOQyXa_body-4 _5NNTzG_carousel-info-description" data-component="Body">The inside story of how Claude Code went from an internal CLI to Anthropic&#x27;s coding agent, told by researchers, engineers and early users who built it.</p><a href="/features/making-of-claude-code" class="f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-secondary f9ZZrG_size-small f9ZZrG_icon-format-trailing _5NNTzG_carousel-info-cta">Read more<span class="f9ZZrG_icon"><svg class="lqbdHG_icon" width="20" height="20" viewBox="0 0 21 21"><path d="M4.14585 9.87492L14.4584 9.87492L9.60419 5.04158L10.5 4.14575L16.8542 10.4999L10.5 16.8541L9.60419 15.9583L14.4584 11.1249L4.14585 11.1249L4.14585 9.87492Z" fill="currentColor"></path></svg></span></a></div><div class="_5NNTzG_carousel-info-body" data-inactive="true" aria-hidden="true" inert=""><header class="nUeDbq_header _5NNTzG_carousel-info-meta"><div class="nUeDbq_headerButton"><button aria-label="Related to Project Deal: our Claude-run marketplace experiment" class="hN4zBq_tiny-more-button hN4zBq_state-closed" type="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_3qcdab5fiv9kcnnb_" aria-haspopup="dialog" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></div><p><a class="wN10Da_link" rel="nofollow" href="/search?topic=agents">Agents</a></p><time class="_5NNTzG_carousel-info-date">Apr 21, 2026</time></header><a class="_5NNTzG_carousel-info-link" href="/features/project-deal"><h2 class="tOQyXa_headline-5 _5NNTzG_carousel-info-title" data-component="Headline">Project Deal: our Claude-run marketplace experiment</h2></a><p class="tOQyXa_body-4 _5NNTzG_carousel-info-description" data-component="Body">We created a marketplace for employees in our San Francisco office, with one big twist. We tasked Claude with buying, selling and negotiating on our colleagues’ behalf.</p><a href="/features/project-deal" class="f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-secondary f9ZZrG_size-small f9ZZrG_icon-format-trailing _5NNTzG_carousel-info-cta">Read more<span class="f9ZZrG_icon"><svg class="lqbdHG_icon" width="20" height="20" viewBox="0 0 21 21"><path d="M4.14585 9.87492L14.4584 9.87492L9.60419 5.04158L10.5 4.14575L16.8542 10.4999L10.5 16.8541L9.60419 15.9583L14.4584 11.1249L4.14585 11.1249L4.14585 9.87492Z" fill="currentColor"></path></svg></span></a></div><div class="_5NNTzG_carousel-info-body" data-inactive="true" aria-hidden="true" inert=""><header class="nUeDbq_header _5NNTzG_carousel-info-meta"><div class="nUeDbq_headerButton"><button aria-label="Related to The first AI-planned drive on Mars" class="hN4zBq_tiny-more-button hN4zBq_state-closed" type="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_3qddab5fiv9kcnnb_" aria-haspopup="dialog" aria-expanded="false"><svg aria-hidden="true" class="hN4zBq_icon" width="8" height="8"><use href="#tiny-more-button-close"></use></svg><svg aria-hidden="true" class="hN4zBq_icon hN4zBq_icon-visible" width="12" height="2"><use href="#tiny-more-button-more"></use></svg></button></div><p><a class="wN10Da_link" href="/news/features">Features</a></p><time class="_5NNTzG_carousel-info-date">Jan 24, 2026</time></header><a class="_5NNTzG_carousel-info-link" href="/features/claude-on-mars"><h2 class="tOQyXa_headline-5 _5NNTzG_carousel-info-title" data-component="Headline">The first AI-planned drive on Mars</h2></a><p class="tOQyXa_body-4 _5NNTzG_carousel-info-description" data-component="Body">The first AI-assisted drive on another planet. Claude helped NASA&#x27;s Perseverance rover travel four hundred meters on Mars.</p><a href="/features/claude-on-mars" class="f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-secondary f9ZZrG_size-small f9ZZrG_icon-format-trailing _5NNTzG_carousel-info-cta">Read more<span class="f9ZZrG_icon"><svg class="lqbdHG_icon" width="20" height="20" viewBox="0 0 21 21"><path d="M4.14585 9.87492L14.4584 9.87492L9.60419 5.04158L10.5 4.14575L16.8542 10.4999L10.5 16.8541L9.60419 15.9583L14.4584 11.1249L4.14585 11.1249L4.14585 9.87492Z" fill="currentColor"></path></svg></span></a></div></div><div role="group" class="n4MhcW_carousel-controls _5NNTzG_carousel-info-controls" aria-label="Carousel controls"><button disabled="" aria-label="Previous slide" data-component="Button" data-variant="tertiary" class="f9ZZrG_button f9ZZrG_corner-small f9ZZrG_variant-tertiary f9ZZrG_size-small f9ZZrG_icon-format-icon-only"><span class="f9ZZrG_icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0" aria-hidden="true"><path d="M8.14648 4.64648C8.34176 4.45136 8.6583 4.45127 8.85352 4.64648C9.04868 4.8417 9.04862 5.15826 8.85352 5.35352L4.70703 9.50001H16.5C16.7761 9.50001 17 9.72387 17 10C16.9999 10.2761 16.7761 10.5 16.5 10.5H4.70703L8.85352 14.6465C9.04863 14.8418 9.04873 15.1583 8.85352 15.3535C8.6583 15.5487 8.34174 15.5486 8.14648 15.3535L3.14648 10.3535C3.05274 10.2598 3.00003 10.1326 3 10C3 9.90061 3.02967 9.80418 3.08398 9.72267L3.14648 9.64649L8.14648 4.64648Z"></path></svg></span></button><div class="n4MhcW_carousel-controls-pagination" aria-live="polite"><div class="n4MhcW_carousel-count">01</div><div>/</div><div class="n4MhcW_carousel-count">